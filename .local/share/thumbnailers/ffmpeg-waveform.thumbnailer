[Thumbnailer Entry]
TryExec=/usr/bin/ffmpeg
Exec=/usr/bin/ffmpeg -y -loglevel error -i %i -filter_complex "showwavespic=s=%sx%s:colors=#3584e4" -frames:v 1 %o
MimeType=audio/mpeg;audio/mp4;audio/x-m4a;audio/flac;audio/ogg;audio/x-vorbis+ogg;audio/opus;audio/x-opus+ogg;audio/vnd.wave;audio/x-wav;audio/aac;audio/x-aac;audio/ac3;audio/x-matroska;audio/webm
